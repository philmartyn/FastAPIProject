# Copy this file to `.env` and adjust the values.
#   cp .env.example .env
#
# NOTE: when running inside docker compose, the DB host is `db` (the service
# name). When running uvicorn locally against the dockerised DB, use
# `localhost`.

# Async driver -> `postgresql+asyncpg://`
DATABASE_URL=postgresql+asyncpg://notes:notes@localhost:5432/notes

# Used to sign the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-long-random-string

DEBUG=true
